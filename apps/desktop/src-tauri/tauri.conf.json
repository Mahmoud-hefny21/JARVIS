{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS", "version": "0.1.0", "identifier": "com.jarvis.personal",
  "build": { "beforeDevCommand": "bun run dev:ui", "beforeBuildCommand": "bun run build", "devUrl": "http://127.0.0.1:1420", "frontendDist": "../../../dist/desktop" },
  "app": {
    "windows": [{ "title": "J.A.R.V.I.S. — Personal intelligence", "width": 1480, "height": 940, "maximized": true, "minWidth": 360, "minHeight": 320, "visible": false, "backgroundColor": "#030c17", "backgroundThrottling": "disabled" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"], "resources": { "../../../docs/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md" }, "shortDescription": "Offline-first personal intelligence", "category": "Productivity", "windows": { "nsis": { "installMode": "currentUser" } } }
}
