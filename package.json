{
  "name": "jarvis", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=24.13.0", "bun": ">=1.3.14" },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "dev:ui": "vite --config apps/desktop/vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:native": "node scripts/native.mjs test",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && vite build --config apps/desktop/vite.config.ts",
    "build:windows": "node scripts/desktop.mjs build",
    "install:windows": "node scripts/install-local.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": { "@tauri-apps/api": "^2.0.0", "zod": "^4.0.0" },
  "devDependencies": { "@playwright/test": "^1.56.0", "@tauri-apps/cli": "^2.0.0", "@types/node": "^24.0.0", "typescript": "^5.9.0", "vite": "^7.0.0" }
}
